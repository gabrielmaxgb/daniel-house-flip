# Cloudflare R2 — upload script (scripts/r2-sync.mjs)
# Dormant by default. Site uses local featured projects + Instagram.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=daniel-house-flip

# Public URL for assets (custom domain or *.r2.dev)
# Example: https://pub-xxxxxxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional override for projects.json location
# PROJECTS_JSON_URL=

# Enable R2 as project source (dormant until needed):
# PROJECTS_SOURCE=r2
# PROJECTS_MEDIA_ON_R2=true
