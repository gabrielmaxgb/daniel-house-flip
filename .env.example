NEXT_PUBLIC_R2_PUBLIC_URL=

# Optional override for projects.json location
# PROJECTS_JSON_URL=

# Set to true after uploading real photos to R2 (data/media + npm run r2:sync)
# PROJECTS_MEDIA_ON_R2=true
