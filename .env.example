# Cloudflare R2 — upload script (scripts/r2-sync.mjs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=daniel-house-flip

# Public URL for assets (custom domain or *.r2.dev)
